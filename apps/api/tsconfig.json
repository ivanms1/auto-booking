{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "types": ["node", "express", "multer"],
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "src/*": ["./src/*"]
    },
    "incremental": true,
    "skipLibCheck": true
  },
  "exclude": [
    "./dist/**/*"
  ]
}
